// =============================================================================
// FRIDA - Firestore Security Rules   (REVIEW BEFORE DEPLOYING)
// =============================================================================
// These rules were derived ONLY from what the FRIDA Admin Android app reads and
// writes. The public website's own Firestore access (creating orders, reading
// invitations, submitting reviews, counting visitors...) was NOT part of the
// archive, so the "public" parts below are best-effort assumptions. Compare
// them with what the website does (or what its Cloudflare Worker does with the
// Admin SDK, which bypasses rules) and adjust BEFORE running:
//
//     firebase deploy --only firestore:rules
//
// Admin = Firebase Auth custom claim  admin == true   (or role == "admin").
// Everything not listed is denied.
// =============================================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // ---- Orders -------------------------------------------------------------
    // Customers (website) may create a PENDING order only; they can never set
    // approval state or host credentials. Everything else is admin-only.
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.status == 'pending'
            && !('hostCode' in request.resource.data)
            && !('accessCode' in request.resource.data)
            && !('approvedAt' in request.resource.data));
    }

    // ---- Invitations --------------------------------------------------------
    // Guests may read published invitations; only admins write.
    match /invitations/{invitationId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow write: if isAdmin();
    }

    // ---- Reviews ------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.approved == true;
      allow create: if request.resource.data.approved == false;
      allow update, delete: if isAdmin();
    }

    // ---- Music / audio / templates -----------------------------------------
    match /music_library/{trackId}   { allow read: if true; allow write: if isAdmin(); }
    match /audio_tracks/{trackId}    { allow read: if true; allow write: if isAdmin(); }
    match /custom_templates/{id}     { allow read: if isAdmin() || resource.data.isActive == true;
                                       allow write: if isAdmin(); }

    // ---- Settings -----------------------------------------------------------
    // public_config / config/public: prices & payment info shown on the website.
    match /settings/public_config    { allow read: if true; allow write: if isAdmin(); }
    match /config/public             { allow read: if true; allow write: if isAdmin(); }
    // admin_config / config/admin: internal (maintenance mode, worker URL...).
    match /settings/admin_config     { allow read, write: if isAdmin(); }
    match /config/admin              { allow read, write: if isAdmin(); }
    // Visitor counter: read by the admin dashboard. If the website increments it from the
    // browser, relax `write` accordingly (or move the increment to the Worker).
    match /settings/visitor_stats    { allow read, write: if isAdmin(); }

    // ---- FCM tokens of admin devices ---------------------------------------
    match /admin_fcm_tokens/{uid}/tokens/{tokenId} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }

    // ---- Default: deny ------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
